# -------------------------------------------------------------
# Shadow Runtime - Environment Configuration Template
# -------------------------------------------------------------

# Google Gemini API Key (Optional: for live Gemini AI models)
GEMINI_API_KEY=

# Core Service (Spring Boot)
CORE_SERVICE_PORT=8080
JWT_SECRET=REPLACE_WITH_STRONG_SECRET
SHADOW_JWT_SECRET=REPLACE_WITH_STRONG_SECRET

# Databases
POSTGRES_DB=shadow_db
POSTGRES_USER=shadow_user
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
SHADOW_POSTGRES_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
MONGO_URI=mongodb://localhost:27017/shadow_telemetry
REDIS_URL=redis://localhost:6379

# Gateway (Node.js)
PORT=4000
CORE_SERVICE_URL=http://localhost:8080

# Frontend (Next.js)
NEXT_PUBLIC_GATEWAY_URL=http://localhost:4000
NEXT_PUBLIC_CORE_URL=http://localhost:8080

# Browser origin allowed by gateway and Socket.IO
SHADOW_CORS_ORIGIN=http://localhost:3000
